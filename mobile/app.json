{
  "expo": {
    "name": "apartmanOS",
    "slug": "apartmanos",
    "scheme": "apartmanos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/apartmanos-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tr.com.apartmanos.mobile"
    },
    "android": {
      "package": "tr.com.apartmanos.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#EAF5FF",
        "foregroundImage": "./assets/apartmanos-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/apartmanos-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://apartmanos.com.tr"
    }
  }
}
